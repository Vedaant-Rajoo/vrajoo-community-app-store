#!/usr/bin/env bash
set -euo pipefail

# umbrelOS remaps the compose mount ${UMBREL_ROOT}/data/storage/downloads to ${UMBREL_ROOT}/home/Downloads.
# Without this, Docker creates the folder owned by root and Suwayomi (UID 1000) can't write to it.
SUWAYOMI_MANGA_DIR="${UMBREL_ROOT}/home/Downloads/manga"
DESIRED_OWNER="1000:1000"

mkdir -p "${SUWAYOMI_MANGA_DIR}"

if [[ "$(stat -c "%u:%g" "${SUWAYOMI_MANGA_DIR}")" != "${DESIRED_OWNER}" ]]; then
	chown "${DESIRED_OWNER}" "${SUWAYOMI_MANGA_DIR}"
fi
